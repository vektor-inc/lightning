{
	"name": "lightning",
	"version": "3.3.0",
	"description": "[![Build Status](https://travis-ci.org/vektor-inc/Lightning.svg?branch=master)](https://travis-ci.org/vektor-inc/Lightning)",
	"main": "gulpfile.js",
	"scripts": {
		"gulp": "gulp",
		"build": "npm run build:script && npm run build:g2panel && npm run build:g3panel && npm run build:text-domain && npx gulp sass",
		"build:g2panel": "webpack --config webpack.g2panel.js",
		"build:g3panel": "webpack --config webpack.g3panel.js",
		"build:sass": "npx gulp sass",
		"dist": "rimraf ./dist/ && rimraf ./vendor/ && composer install --optimize-autoloader --prefer-dist --no-dev && npm run build && node copy-files.js && rimraf ./dist/lightning/_g2/tests/ && rimraf ./dist/lightning/_g3/tests/ && cd dist && zip -r lightning.zip lightning",
		"build:script": "webpack --config webpack.g2prod.js && webpack --config webpack.g3prod.js",
		"build:text-domain": "gulp text-domain",
		"watch:script": "webpack --config webpack.g3dev.js --watch",
		"watch:script-g2": "webpack --config webpack.g2dev.js --watch",
		"watch:script-g3": "webpack --config webpack.g3dev.js --watch",
		"watch:style": "gulp watch",
		"composer:install:win": "wp-env run composer \"composer install\"",
		"composer:install:mac": "wp-env run composer 'composer install'",
		"phpunit": "npm run phpunit:root && npm run phpunit:g2 && npm run phpunit:g3",
		"phpunit:root": "wp-env run --env-cwd='wp-content/themes/lightning' tests-cli vendor/bin/phpunit -c phpunit.root.xml",
		"phpunit:g2": "wp-env run --env-cwd='wp-content/themes/lightning' tests-cli vendor/bin/phpunit -c phpunit.g2.xml",
		"phpunit:g3": "wp-env run --env-cwd='wp-content/themes/lightning' tests-cli vendor/bin/phpunit -c phpunit.g3.xml",
		"phpunit:win": "wp-env run phpunit \"phpunit -c /var/www/html/wp-content/themes/lightning/phpunit.g3.xml --verbose\"",
		"e2e": "npx playwright test --project=chromium"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vektor-inc/Lightning.git"
	},
	"author": "Vektor, Inc.",
	"license": "GPL-2.0-only",
	"bugs": {
		"url": "https://github.com/vektor-inc/Lightning/issues"
	},
	"homepage": "https://lightning.vektor-inc.co.jp/en/",
	"devDependencies": {
		"@babel/core": "^7.29.6",
		"@babel/preset-env": "^7.24.5",
		"@playwright/test": "^1.62.1",
		"@wordpress/env": "^10.30.0",
		"@wordpress/scripts": "^31.8.0",
		"babel-loader": "^9.1.3",
		"clean-css": "^5.3.3",
		"gulp": "^5.0.1",
		"gulp-autoprefixer": "^9.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-cssmin": "^0.2.0",
		"gulp-plumber": "^1.2.1",
		"gulp-rename": "^2.1.0",
		"gulp-replace": "^1.1.4",
		"gulp-sass": "^5.1.0",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-style-aliases": "^1.1.11",
		"postcss": "^8.5.26",
		"rimraf": "^5.0.7",
		"run-sequence": "^2.2.1",
		"sass": "^1.103.1",
		"through2": "^4.0.2",
		"vinyl-sourcemaps-apply": "^0.2.1",
		"webpack": "^5.110.3",
		"webpack-cli": "^5.1.4",
		"webpack-merge": "^5.10.0"
	},
	"volta": {
		"node": "20.13.1"
	},
	"dependencies": {
		"bootstrap": "^4.6.2",
		"fs-extra": "^11.2.0",
		"glob": "^10.5.0",
		"is-mobile": "^4.0.0"
	}
}

<?xml version="1.0"?>
<ruleset name="Lightning">
	<description>WordPress コーディング規約をベースにした Lightning 用のルールセット。</description>

	<!-- What to scan -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>

	<!-- How to scan -->
	<!-- Usage instructions: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Usage -->
	<!-- Annotated ruleset: https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="basepath" value="./"/><!-- Strip the file paths down to the relevant bit -->
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/><!-- Enables parallel processing when available for faster results. -->

	<!-- Rules: Check PHP version compatibility -->
	<!-- https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<!-- style.css の Requires PHP に合わせる. -->
	<config name="testVersion" value="7.4-"/>
	<!-- https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Rules: WordPress Coding Standards -->
	<!-- https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards -->
	<!-- https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards/wiki/Customizable-sniff-properties -->
	<!-- style.css の Requires at least に合わせる. -->
	<config name="minimum_supported_wp_version" value="6.5"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<!-- グローバルに定義する関数・クラス・変数の接頭辞.
				 lightning_ は lightning_* / Lightning_*、ltg_ は ltg_* / LTG_* を対象とする（大文字小文字は区別されない）. -->
			<property name="prefixes" type="array">
				<element value="lightning_"/>
				<element value="ltg_"/>
			</property>
		</properties>
		<!-- テストクラス・テストメソッドは PHPUnit の命名規約に従うため対象外とする. -->
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<!-- style.css の Text Domain に合わせる. -->
			<property name="text_domain" type="array">
				<element value="lightning"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<!-- コメントは日本語で書く方針のため、英文を前提とした「大文字で始めること」の検査は無効化する.
		 日本語には大文字小文字の区別が無く、原理的に満たせないため. -->
	<rule ref="Generic.Commenting.DocComment.ShortNotCapital">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.Commenting.DocComment.LongNotCapital">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.BlockComment.NoCapital">
		<severity>0</severity>
	</rule>
	<!-- Squiz.Commenting.InlineComment.NotCapital は WordPress-Docs の ruleset が
		 既に exclude しているため、ここで無効化しても検出件数は変わらない。
		 二重に書くと「効いている」と誤解されるので指定しない。
		 なおこれは WPCS 側の実装に依存するため、将来 WPCS が exclude をやめた場合は
		 このコメントを消して上と同じ形の severity 0 の指定を足すこと. -->

	<!-- テストコードでは、失敗時の診断のために出力系の関数を使うため対象外とする.
		 なお exclude-pattern はファイルの絶対パスに対する非アンカーの正規表現として当たるため、
		 /tests/ はリポジトリ内の tests/ ・ _g2/tests/ ・ _g3/tests/ の 3 箇所すべてに効く。
		 チェックアウト先の親ディレクトリ名に tests が含まれる場合はリポジトリ全体が除外されるので、
		 そのような場所には配置しないこと.
		 例外メッセージのエスケープ（ExceptionNotEscaped）は診断出力とは別なので、対象外にするのは
		 OutputNotEscaped だけに絞る. -->
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>
</ruleset>
